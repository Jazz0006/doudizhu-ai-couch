# Complete-local voice defaults. Secrets must never use the VITE_ prefix.
COACH_PROVIDER=ollama
CLOUD_FALLBACK_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=45000
VOICE_TTS_THREADS=4

# HTTPS server. Generate these files with: npm run voice:setup:https
TLS_CERT_PATH=certs/local/local-cert.pem
TLS_KEY_PATH=certs/local/local-key.pem

# Vite proxies same-origin /api and WSS traffic to this backend.
VOICE_SERVER_ORIGIN=https://127.0.0.1:3000
# Optional override; defaults to <repository>/models/voice.
# VOICE_MODELS_DIR=C:\absolute\path\to\models\voice

# Optional cloud mode. Keep disabled unless the user explicitly opts in.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
