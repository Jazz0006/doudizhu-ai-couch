{
  "name": "ai-doudizhu-coach",
  "version": "0.0.0",
  "private": true,
  "description": "AI 斗地主实时语音教练 monorepo",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "voice:download": "powershell -ExecutionPolicy Bypass -File scripts/voice/download-models.ps1",
    "voice:setup:https": "powershell -ExecutionPolicy Bypass -File scripts/voice/setup-local-https.ps1",
    "voice:smoke:https": "powershell -ExecutionPolicy Bypass -File scripts/voice/smoke-local-https.ps1",
    "voice:smoke:asr": "npm run build --workspace @ai-doudizhu/server && node scripts/voice/smoke-local-asr.mjs",
    "voice:smoke:coach": "npm run build --workspace @ai-doudizhu/server && node scripts/voice/smoke-local-coach.mjs",
    "voice:smoke:tts": "npm run build --workspace @ai-doudizhu/server && node scripts/voice/smoke-local-tts.mjs",
    "voice:dev:server": "powershell -ExecutionPolicy Bypass -File scripts/voice/start-local-server.ps1",
    "voice:dev:web": "powershell -ExecutionPolicy Bypass -File scripts/voice/start-local-web.ps1",
    "voice:probe:runtime": "node scripts/voice/probe-runtime.cjs",
    "voice:probe:asr": "node scripts/voice/probe-asr.cjs",
    "voice:probe:tts": "node scripts/voice/probe-tts.cjs",
    "voice:benchmark:ollama": "node scripts/voice/benchmark-ollama.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
